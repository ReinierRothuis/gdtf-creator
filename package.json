  "scripts": {
    "benchmark": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/benchmark.ts",
    "build": "react-router build",
    "cf-typegen": "wrangler types",
    "deploy": "pnpm run build && wrangler deploy",
    "dev": "react-router dev",
