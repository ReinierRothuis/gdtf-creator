    "ai": "^6.0.293",
    "convex": "^1.46.0",
    "fast-xml-parser": "^5.11.1",
    "isbot": "^5.2.2",
    "jszip": "^3.10.2",
    "lucide-react": "^0.575.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "three": "^0.183.2",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
